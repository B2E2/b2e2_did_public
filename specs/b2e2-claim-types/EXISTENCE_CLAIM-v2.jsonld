        },
        "consumption": {
          "@id": "https://b2e2.github.io/b2e2_did_public/specs/b2e2-claim-types#existenceType/consumption",
          "@comment": "The plant is a consumption facility"
        },
        "storage": {
          "@id": "https://b2e2.github.io/b2e2_did_public/specs/b2e2-claim-types#existenceType/storage",
          "@comment": "The plant is an energy storage facility"
        },
        "hybrid": {
          "@id": "https://b2e2.github.io/b2e2_did_public/specs/b2e2-claim-types#existenceType/hybrid",
